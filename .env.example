# =============================================================================
# VPS Attack Detector - Configuração de Ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# NUNCA comite o arquivo .env - ele contém credenciais sensíveis.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL para Airflow)
# -----------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_password_change_me
POSTGRES_DB=airflow

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
# Gere uma chave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Chave secreta para sessões web
AIRFLOW_SECRET_KEY=change-me-in-production-use-random-string
# Credenciais de admin
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_change_me

# Porta do webserver (evite conflitos com outras apps)
AIRFLOW_PORT=8085

# -----------------------------------------------------------------------------
# Spark
# -----------------------------------------------------------------------------
# Ajuste conforme a RAM disponível no seu VPS
# Para um VPS de 8GB rodando outras apps, valores conservadores:
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_CONTAINER_MEMORY=2500M
SPARK_UI_PORT=8082

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
DASHBOARD_PORT=8501

# -----------------------------------------------------------------------------
# Ingestão de Logs - Local
# -----------------------------------------------------------------------------
# Caminho local para os logs (montado no container)
# Em produção no VPS, aponte para /var/log ou um diretório específico
LOCAL_LOG_PATH=./data/sample_logs

# -----------------------------------------------------------------------------
# Ingestão de Logs - Remoto (Opcional)
# -----------------------------------------------------------------------------
# Se os logs estiverem em outro servidor, configure a sincronização via SSH
# Deixe REMOTE_HOST vazio para desabilitar sync remoto
REMOTE_HOST=
REMOTE_USER=
REMOTE_SSH_PORT=22
# Caminhos separados por vírgula, ex: /var/log/auth.log,/var/log/nginx/access.log
REMOTE_LOG_PATHS=
# Caminho para a chave SSH privada (sem senha)
SSH_KEY_FILE=

# -----------------------------------------------------------------------------
# GeoIP (Opcional)
# -----------------------------------------------------------------------------
# Caminho para o banco de dados GeoIP (DB-IP Lite ou MaxMind GeoLite2)
# Baixe gratuitamente de: https://db-ip.com/db/download/ip-to-city-lite
# ou https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DB_PATH=./data/geoip/dbip-city-lite.mmdb

# Licença MaxMind (se usar GeoLite2 em vez de DB-IP)
# Registre-se em: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# -----------------------------------------------------------------------------
# Detecção de Ataques - Limiares
# -----------------------------------------------------------------------------
# Estes valores podem ser sobrescritos no arquivo config/detection_rules.yaml
# SSH brute force: falhas por IP em janela de tempo
SSH_FAILED_THRESHOLD=5
SSH_WINDOW_MINUTES=10

# HTTP scanning: 404s por IP em janela de tempo
HTTP_404_THRESHOLD=20
HTTP_WINDOW_MINUTES=5

# Rate limiting: requisições por IP por minuto
HTTP_RATE_LIMIT=100

# -----------------------------------------------------------------------------
# Alertas e Outputs
# -----------------------------------------------------------------------------
# Gerar arquivo de blocklist para fail2ban/ufw (true/false)
GENERATE_BLOCKLIST=true
BLOCKLIST_OUTPUT_PATH=./data/output/blocklist.txt

# Webhook para alertas (opcional, ex: Slack, Discord)
ALERT_WEBHOOK_URL=
